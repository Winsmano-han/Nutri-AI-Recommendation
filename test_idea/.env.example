# Multi-Provider LLM Test Configuration
# Copy these values from your main scraper/.env or set them here

# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_key_here

# Gemini API Key (get from https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_key_here

# Optional: Add more Groq keys for higher throughput
# GROQ_API_KEY_2=your_second_groq_key_here
# GROQ_API_KEY_3=your_third_groq_key_here

# Optional: Timeout settings (milliseconds)
GROQ_TIMEOUT_MS=45000
GROQ_MAX_RETRY_WAIT_MS=15000
